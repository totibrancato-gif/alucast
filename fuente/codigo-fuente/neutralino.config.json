{
  "$schema": "https://raw.githubusercontent.com/neutralinojs/neutralinojs/main/schemas/neutralino.config.schema.json",
  "applicationId": "uy.alucast.presupuestos",
  "version": "1.0.0",
  "defaultMode": "window",
  "port": 47615,
  "documentRoot": "/resources/",
  "url": "/",
  "enableServer": true,
  "enableNativeAPI": true,
  "tokenSecurity": "one-time",
  "logging": { "enabled": false, "writeToLogFile": false },
  "nativeAllowList": ["app.exit", "os.open", "os.getPath", "os.showSaveDialog", "os.showOpenDialog", "filesystem.writeFile", "filesystem.writeBinaryFile", "filesystem.readFile"],
  "globalVariables": {},
  "modes": {
    "window": {
      "title": "Presupuestos Alucast",
      "width": 1280, "height": 860, "minWidth": 380, "minHeight": 500,
      "center": true, "fullScreen": false, "alwaysOnTop": false,
      "icon": "/resources/icon-512.png",
      "enableInspector": false, "borderless": false, "maximize": false, "hidden": false, "resizable": true, "exitProcessOnClose": true
    }
  },
  "cli": {
    "binaryName": "Alucast",
    "resourcesPath": "/resources/",
    "extensionsPath": "/extensions/",
    "clientLibrary": "/resources/js/neutralino.js",
    "binaryVersion": "6.1.0",
    "clientVersion": "6.1.0"
  }
}
